# PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/cargo_admin?schema=public
# Supabase: use the *Session pooler* string from Connect, plus ?sslmode=require&connection_limit=5
#           (see DEPLOY.md, section C)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cargo_admin?schema=public"

# Passwords for the two logins. Locally they default to admin123 / staff123; in production
# they are REQUIRED. Set strong ones whenever the database is shared or public (e.g. Supabase).
# SEED_ADMIN_PASSWORD="..."
# SEED_STAFF_PASSWORD="..."

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
