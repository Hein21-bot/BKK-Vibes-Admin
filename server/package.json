{
  "name": "cargo-admin-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "render-build": "prisma generate && prisma db push --skip-generate",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset --accept-data-loss && node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:copy": "node scripts/copy-db.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
